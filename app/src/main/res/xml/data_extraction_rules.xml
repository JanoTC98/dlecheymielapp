<?xml version="1.0" encoding="utf-8"?><!--
   The session cookie must never leave the device: not in cloud backups (Android 12+) and not in device-to-device
   transfers, which allowBackup="false" does not cover.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dleche_session_cookies.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dleche_session_cookies.xml"/>
    </device-transfer>
</data-extraction-rules>
